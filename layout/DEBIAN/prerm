#!/bin/sh
case "$(dpkg --print-architecture)" in iphoneos-arm64) PREFIX=/var/jb ;; *) PREFIX= ;; esac
PLIST=$PREFIX/Library/LaunchDaemons/com.xcode.autohotspot.plist
case "$1" in
    remove|deconfigure)
        launchctl unload "$PLIST" 2>/dev/null
        # launchd kills the daemon outright, so close the hotspot it opened here.
        "$PREFIX/usr/libexec/autohotspotd" --release
        ;;
    upgrade|failed-upgrade)
        # The new version resumes a hotspot the old one opened.
        launchctl unload "$PLIST" 2>/dev/null
        ;;
esac
exit 0
